{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "ignoreDeprecations": "5.0",
    "rootDir": "./reports_app/static/reports_app/ts",
    "outDir": "./reports_app/static/reports_app/js",
    "sourceMap": true,
    "declaration": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  },
  "include": [
    "reports_app/static/reports_app/ts/**/*.ts",
    "reports_app/static/reports_app/ts/**/*.d.ts"
  ]
}